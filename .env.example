NODE_ENV=development

DATABASE_URL=postgres://postgres:postgres@localhost:5432/alice_innovation

# Bearer token for /mcp and, when enabled, admin. Never commit a real token.
MCP_AUTH_TOKEN=
AUTH_MODE=token

PORT=8080
ADMIN_PORT=8081
ADMIN_ENABLED=false

# Innovation Library web UI (apps/web)
WEB_PORT=3000

# OpenAI-compatible embeddings via OpenRouter (production) or another gateway.
# Production on Railway must use a hosted HTTPS endpoint — not loopback.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Optional OpenRouter attribution header
# OPENROUTER_HTTP_REFERER=https://your-web-app.example
# Development only (same host): EMBEDDING_BASE_URL=http://127.0.0.1:9888/v1 EMBEDDING_API_KEY=local

# Classifier is off unless this is exactly true. Search never calls it.
CLASSIFIER_ENABLED=false
CLASSIFIER_PROVIDER=
CLASSIFIER_BASE_URL=
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=

INGESTION_USER_AGENT=AliceInnovationLibrary/0.1 (+https://github.com/Yevucee/Alice-Innovation)
INGESTION_DEFAULT_CONCURRENCY=1
INGESTION_REQUEST_TIMEOUT_MS=20000

LOG_LEVEL=info
SERVICE_NAME=alice

# Post-ingest enrichment (OpenRouter chat). Uses EMBEDDING_API_KEY when ENRICH_API_KEY is unset.
ENRICH_ENABLED=true
ENRICH_BASE_URL=https://openrouter.ai/api/v1
ENRICH_API_KEY=
ENRICH_MODEL=google/gemini-2.5-flash-lite
ENRICH_MAX_PER_RUN=15000
ENRICH_MAX_COST_USD=3
ENRICH_MAX_MINUTES=90
ENRICH_ON_INGEST=false
INGEST_PROGRESS_EVERY=25
ENRICH_PROGRESS_EVERY=50
ENRICH_FETCH_MIN_INTERVAL_MS=1000
ENRICH_CONCURRENCY=8
ENRICH_FALLBACK_MODEL=openai/gpt-4o-mini
ENRICH_BACKFILL_ON_INGEST=true

# Incremental catalogue ingest (skip recent detail fetches when listing snapshot unchanged).
INGEST_DETAIL_REFETCH_DAYS=7
INGEST_DETAIL_BOOTSTRAP_DAYS=30
INGEST_DETAIL_CONCURRENCY=4
INGEST_SOURCE_LOOP_MAX_MINUTES=60

# Quality audit after each ingest run (sets NEEDS_REVIEW, never deletes).
QUALITY_AUDIT_ON_INGEST=true

# Post-ingest thumbnail backfill for newly touched resources (HEAD-validated og/json-ld images).
IMAGE_BACKFILL_ON_INGEST=true
IMAGE_BACKFILL_MAX_PER_RUN=150
IMAGE_MIN_BYTES=256

# One-time post-deploy job queue (Oct 2025 scraper/image deploy). Each Run now advances one step.
POST_DEPLOY_JOBS_ON_INGEST=true
POST_DEPLOY_JOBS_MAX_MINUTES=30
# Default true: post-deploy runs before ingest when manual or when jobs are pending. Set false to opt out.
POST_DEPLOY_BEFORE_INGEST=true
POST_DEPLOY_REINGEST_ITEMS_PER_RUN=120
POST_DEPLOY_FULL_PASSES_PER_SOURCE=2
POST_DEPLOY_IMAGE_BACKFILL_PER_RUN=80
POST_DEPLOY_JOB_MAX_MINUTES=15
POST_DEPLOY_IMAGE_BACKFILL_STALL_STEPS=5
INGEST_FIRST_RUN_ITEM_LIMIT=500
# Inline UI translation (web service): Google preferred, else OpenRouter
GOOGLE_TRANSLATION_API_KEY=
TRANSLATE_PROVIDER=auto
TRANSLATE_MODEL=google/gemini-2.5-flash-lite
# Future ingest: fill resources.source_summary_en when provider is wired
INGEST_TRANSLATE_SUMMARY_TO_EN=false

EMBEDDING_BACKFILL_ON_INGEST=true
EMBEDDING_BACKFILL_MAX_PER_RUN=20000
