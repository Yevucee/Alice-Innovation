NODE_ENV=development

DATABASE_URL=postgres://postgres:postgres@localhost:5432/alice_innovation

# Bearer token for /mcp and, when enabled, admin. Never commit a real token.
MCP_AUTH_TOKEN=
AUTH_MODE=token

PORT=8080
ADMIN_PORT=8081
ADMIN_ENABLED=false

# Innovation Library web UI (apps/web)
WEB_PORT=3000
WEB_SESSION_SECRET=
WEB_AUTH_PASSWORD=

# OpenAI-compatible embeddings. Default model is text-embedding-3-small (1536).
# Production on Railway must use a hosted endpoint. Do not point Railway at a loopback address.
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Development only: a machine on the same host can serve an OpenAI-compatible API, for example
# EMBEDDING_BASE_URL=http://127.0.0.1:9888/v1
# EMBEDDING_MODEL=local-8b
# EMBEDDING_API_KEY=local
# The library does not assume that server exists. Vectors are stored at 1536 dimensions.

# Classifier is off unless this is exactly true. Search never calls it.
CLASSIFIER_ENABLED=false
CLASSIFIER_PROVIDER=
CLASSIFIER_BASE_URL=
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=

INGESTION_USER_AGENT=AliceInnovationLibrary/0.1 (+https://github.com/Yevucee/Alice-Innovation)
INGESTION_DEFAULT_CONCURRENCY=1
INGESTION_REQUEST_TIMEOUT_MS=20000

LOG_LEVEL=info
SERVICE_NAME=alice
