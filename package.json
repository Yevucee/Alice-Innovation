{
  "name": "alice-innovation-library",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Alice Innovation Library: provenance-first search across approved innovation sources, exposed over remote MCP.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "mcp": "tsx apps/mcp/src/index.ts",
    "ingest": "tsx apps/ingestor/src/index.ts",
    "check:image-coverage": "tsx scripts/check-image-coverage.ts",
    "ingest:production-backfill-images": "bash scripts/ingest-production-backfill-images.sh",
    "ingest:production-backfill-images:remote": "bash scripts/run-with-production-env.sh npm run ingest:production-backfill-images",
    "backfill:images-from-db": "tsx scripts/backfill-images-from-db.ts",
    "backfill:images-from-db:remote": "bash scripts/run-with-production-env.sh npm run backfill:images-from-db",
    "backfill:listing-card-images": "tsx scripts/backfill-listing-card-images.ts",
    "backfill:listing-card-images:remote": "bash scripts/run-with-production-env.sh npm run backfill:listing-card-images",
    "backfill:solar-images-all:remote": "bash scripts/run-with-production-env.sh bash scripts/backfill-solar-images-all.sh",
    "ingest:production-step2:remote": "bash scripts/run-with-production-env.sh bash scripts/ingest-production-step2-catalogue.sh",
    "ingest:production-step3:remote": "bash scripts/run-with-production-env.sh bash scripts/ingest-production-step3-catalogue.sh",
    "ingest:production-step4:remote": "bash scripts/run-with-production-env.sh bash scripts/ingest-production-step4-sources.sh",
    "ingest:production-step5:remote": "bash scripts/run-with-production-env.sh bash scripts/ingest-production-step5-catalogue.sh",
    "ingest:production-step6:remote": "bash scripts/run-with-production-env.sh bash scripts/ingest-production-step6-catalogue.sh",
    "ingest:production-step7:remote": "bash scripts/run-with-production-env.sh bash scripts/ingest-production-step7-depth.sh",
    "ingest:production-backfill-catalogues:remote": "bash scripts/run-with-production-env.sh bash scripts/ingest-production-backfill-catalogues.sh",
    "ingest:production-ops-queue:remote": "bash scripts/run-with-production-env.sh bash scripts/ingest-production-ops-queue.sh",
    "ingest:production-step8:remote": "bash scripts/run-with-production-env.sh bash scripts/ingest-production-step8-remaining.sh",
    "ingest:single-flight:remote": "bash scripts/run-with-production-env.sh bash scripts/ingest-single-flight-queue.sh",
    "ingest:africa:remote": "bash scripts/run-with-production-env.sh bash scripts/ingest-production-africa-queue.sh",
    "ingest:africa-full:remote": "bash scripts/run-with-production-env.sh bash scripts/ingest-production-africa-full-only.sh",
    "ingest:africa-tail:remote": "bash scripts/run-with-production-env.sh bash scripts/ingest-production-africa-tail.sh",
    "ingest:global-backfill:remote": "bash scripts/run-with-production-env.sh bash scripts/ingest-production-global-backfill.sh",
    "ingest:wait-then-global-backfill:remote": "bash scripts/run-with-production-env.sh bash scripts/wait-then-ingest-global-backfill.sh",
    "ingest:africa-second-pass:remote": "bash scripts/run-with-production-env.sh bash scripts/ingest-production-africa-second-pass.sh",
    "setup:africa-second-pass-enable": "tsx scripts/setup-africa-second-pass-enable.ts",
    "backfill:africa-countries:remote": "bash scripts/run-with-production-env.sh npx tsx scripts/backfill-africa-country-from-metadata.ts",
    "setup:africa-rollout": "tsx scripts/setup-africa-rollout.ts",
    "ops:cleanup-stale-runs": "tsx scripts/ops-cleanup-stale-ingestion-runs.ts",
    "ops:cleanup-stale-runs:remote": "bash scripts/run-with-production-env.sh npm run ops:cleanup-stale-runs",
    "ops:coverage": "tsx scripts/ops-source-coverage-report.mjs",
    "ops:coverage:remote": "bash scripts/run-with-production-env.sh npm run ops:coverage",
    "check:africa-index": "tsx scripts/check-africa-index.ts",
    "check:africa-index:remote": "bash scripts/run-with-production-env.sh npm run check:africa-index",
    "check:africa-ingest": "tsx scripts/check-africa-ingest-status.ts",
    "check:africa-ingest:remote": "bash scripts/run-with-production-env.sh npm run check:africa-ingest",
    "classify:batch": "tsx scripts/classify-batch.ts",
    "classify:batch:remote": "bash scripts/run-with-production-env.sh npm run classify:batch",
    "hubs:discover": "tsx scripts/hub-discovery.ts",
    "hubs:discover:remote": "bash scripts/run-with-production-env.sh npm run hubs:discover",
    "hubs:enrich": "tsx scripts/hub-enrich.ts",
    "hubs:enrich:remote": "bash scripts/run-with-production-env.sh npm run hubs:enrich",
    "smoke:production": "tsx scripts/production-smoke-test.ts",
    "smoke:production:remote": "bash scripts/run-with-production-env.sh npm run smoke:production",
    "admin": "tsx apps/admin/src/index.ts",
    "web": "npm run dev -w @alice/web",
    "web:build": "npm run build -w @alice/web",
    "start:web": "npm run start -w @alice/web",
    "start:mcp": "tsx apps/mcp/src/index.ts",
    "start:ingestor": "tsx apps/ingestor/src/index.ts",
    "start:admin": "tsx apps/admin/src/index.ts"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
