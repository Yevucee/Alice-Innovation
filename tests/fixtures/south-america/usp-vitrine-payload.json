3C/span>\u003C/span>\u003C/span>\u003Cspan style=\"font-size:6.0pt\">\u003Cspan style=\"font-family:Arial\">\u003Cspan style=\"color:#3f3f3f\">\u003Cspan style=\"language:en-US\">\u003Cstrong style=\"font-weight:bold\">\u003Cem style=\"font-style:italic\">Chemical Engineering Journal, Volume 408, 2021, 127279. Doi: 10.1016/j.cej.2020.127279\u003C/em>\u003C/strong>\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003C/div>\u003Cdiv style=\"line-height:10pt\">\u003Cbr/>\u003C/div>\u003Cdiv style=\"line-height:10pt\">\u003Cspan style=\"font-size:8.5pt; font-variant:normal; white-space:pre-wrap\">\u003Cspan style=\"font-family:Arial\">\u003Cspan style=\"color:#077a9e\">\u003Cstrong style=\"font-weight:700\">\u003Cspan style=\"font-style:normal\">\u003Cspan style=\"text-decoration:none\">DIFERENCIAL\u003C/span>\u003C/span>\u003C/strong>\u003C/span>\u003C/span>\u003C/span>\u003C/div>\u003Cdiv style=\"line-height:10pt\">\u003Cbr/>\u003C/div>\u003Cdiv style=\"line-height:10pt\">\u003Cspan style=\"font-size:8.5pt; font-variant:normal; white-space:pre-wrap\">\u003Cspan style=\"font-family:Arial\">\u003Cspan style=\"color:#3f3f3f\">\u003Cspan style=\"font-weight:400\">\u003Cspan style=\"font-style:normal\">\u003Cspan style=\"text-decoration:none\">A tecnologia propõe \u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003Cspan style=\"font-size:8.0pt\">\u003Cspan style=\"font-family:Arial\">\u003Cspan style=\"color:#3f3f3f\">\u003Cspan style=\"language:pt-BR\">um método analítico rápido, de simples manuseio e de baixo custo para fazer uma análise quantitativa e qualitativa além de detectar importantes classes de pesticidas carbamatos, fenilamidas, \u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003Cspan style=\"font-size:8.0pt\">\u003Cspan style=\"font-family:Arial\">\u003Cspan style=\"color:#3f3f3f\">\u003Cspan style=\"language:pt-BR\">bipiridínio\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003Cspan style=\"font-size:8.0pt\">\u003Cspan style=\"font-family:Arial\">\u003Cspan style=\"color:#3f3f3f\">\u003Cspan style=\"language:pt-BR\"> e organofosforados sem necessidade de incorporar elementos biológicos. Isso permite o controle de qualidade de água e alimentos, além de permitir a triagem de vários analitos e uma análise química descentralizada\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003Cspan style=\"font-size:8.5pt; font-variant:normal; white-space:pre-wrap\">\u003Cspan style=\"font-family:Arial\">\u003Cspan style=\"color:#3f3f3f\">\u003Cspan style=\"font-weight:400\">\u003Cspan style=\"font-style:normal\">\u003Cspan style=\"text-decoration:none\">.\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003C/div>\u003Cdiv style=\"line-height:10pt\">\u003Cbr/>\u003C/div>\u003Cdiv style=\"line-height:10pt\">\u003Cspan style=\"font-size:8.5pt; font-variant:normal; white-space:pre-wrap\">\u003Cspan style=\"font-family:Arial\">\u003Cspan style=\"color:#077a9e\">\u003Cstrong style=\"font-weight:700\">\u003Cspan style=\"font-style:normal\">\u003Cspan style=\"text-decoration:none\">APLICAÇÕES E PÚBLICO - ALVO\u003C/span>\u003C/span>\u003C/strong>\u003C/span>\u003C/span>\u003C/span>\u003C/div>\u003Cdiv style=\"line-height:10pt\">\u003Cbr/>\u003C/div>\u003Cdiv style=\"line-height:10pt\">\u003Cspan style=\"font-size:8.5pt; font-variant:normal; white-space:pre-wrap\">\u003Cspan style=\"font-family:Arial\">\u003Cspan style=\"color:#3f3f3f\">\u003Cspan style=\"font-weight:400\">\u003Cspan style=\"font-style:normal\">\u003Cspan style=\"text-decoration:none\">A \u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003Cspan style=\"font-size:8.0pt\">\u003Cspan style=\"font-family:Arial\">\u003Cspan style=\"color:#3f3f3f\">\u003Cspan style=\"language:pt-BR\">inovação apresentada se insere no campo no domínio da Química e Materiais, estando dentro das áreas ambiental, da saúde e controle de qualidade de alimentos sendo passível de ser conduzida em lavouras, supermercados, indústria de processamento de alimentos e em qualquer outro local de análise em que os alimentos estejam condicionados. Além disso, seu emprego pode ser estendido para amostras ambientais como as de água, rios, mares, córregos e lagos, por exemplo\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003Cspan style=\"font-size:8.5pt; font-variant:normal; white-space:pre-wrap\">\u003Cspan style=\"font-family:Arial\">\u003Cspan style=\"color:#3f3f3f\">\u003Cspan style=\"font-weight:400\">\u003Cspan style=\"font-style:normal\">\u003Cspan style=\"text-decoration:none\">.\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003C/span>\u003C/div>\u003Cdiv style=\"line-height:10pt\">\u003Cbr/>\u003C/div>\u003Cdiv style=\"line-height:10pt\">\u003Cspan style=\"font-size:8.5pt; font-variant:normal; white-space:pre-wrap\">\u003Cspan style=\"font-family:Arial\">\u003Cspan style=\"color:#077a9e\">\u003Cstrong style=\"font-weight:700\">\u003Cspan style=\"font-style:normal\">\u003Cspan style=\"text-decoration:none\">ESTÁGIO DE DESENVOLVIMENTO\u003C/span>\u003C/span>\u003C/strong>\u003C/span>\u003C/span>\u003C/span>\u003C/div>\u003Cdiv style=\"line-height:10pt\">\u003Cp style=\"text-align:center\">\u003Cimg alt=\"\" data-cke-saved-src=\"https://dev.uspdigital.usp.br/inventor/api/divulgacao/arquivo/publico/aGxFMTIxNzgzNjI\" src=\"https://dev.uspdigital.usp.br/inventor/api/divulgacao/arquivo/publico/aGxFMTIxNzgzNjI\" style=\"height:200px; width:514px\"/>\u003C/p>\u003Cdiv style=\"line-height:8pt\">\u003Cspan style=\"font-size:8pt; font-variant:normal; white-space:pre-wrap\">\u003Cspan style=\"font-family:Arial\">\u003Cspan style=\"color:#077a9e\">\u003Cstrong style=\"font-weight:700\">\u003Cem style=\"font-style:italic\">\u003Cspan style=\"text-decoration:none\">Área: Agropecuária; Alimentos, Saúde e Cuidados (Humanos e Animais), Outros;  0018/2021 \u003C/span>\u003C/em>\u003C/strong>\u003C/span>\u003C/span>\u003C/span>\u003C/div>\u003Cdiv st